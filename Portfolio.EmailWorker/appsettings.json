{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Environment": {
    "IsDevelopment": true
  },
  "Email": {
    "Processing": {
      "ApplicationMaxEmailsPerSecond": 7,
      "ApplicationRateLimitQueueLimit": 1000,
      "MaxEmailRetries": 3
    }
  },
  "EmailBranding": {
    "Name": "Portfolio Studio",
    "Tagline": "Software engineering • Cloud • Architecture",
    "WebsiteUrl": "https://tonybrill.dev",
    "GitHubUrl": "https://github.com/tbrill2037",
    "LinkedInUrl": "https://www.linkedin.com/in/tony-brill-254374282",
    "StackOverflowUrl": "https://stackoverflow.com/users/23000764/tony-b"
  },
  "AWS": {
    "SES": {
      "MaxEmailsPerSecond": 1, //7 in PRODUCTION, 1 in DEV
      "RateLimitQueueLimit": 1000,
      "LowQuotaThreshold": 20,
      "ConfigurationSet": "my-first-configuration-set"
    },
    "Secrets": {
      "SecretName": "portfolio-api-production"
    },
    "Lambda": {
      "EmailProcessingBuffer": "00:00:30", // Longer buffer because it accesses external services
      "DevelopmentFallbackTime": "00:01:00"
    }
  }
}
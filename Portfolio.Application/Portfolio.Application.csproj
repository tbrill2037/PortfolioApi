<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- AutoMapper 12.x has a known advisory; pin to 11.0.1 for now to avoid vulnerability until project owners opt to upgrade and update extensions. -->
    <PackageReference Include="AutoMapper" Version="17.0.0" />
    <PackageReference Include="FluentValidation" Version="11.9.0" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="11.9.0" />
    <PackageReference Include="MediatR" Version="12.2.0" />
    <!-- Attempt to use AutoMapper.Extensions compatible with AutoMapper 16.x if available -->
    <!-- AutoMapper.Extensions for 16.x is not available on nuget.org; remove to use manual registration -->
    <!-- Note: AutoMapper.Extensions 12.x expects AutoMapper 12.x. If runtime issues occur, consider using AutoMapper 12 or replacing extension with manual IMapper registration. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Identity.Core" Version="10.0.9" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.19.1" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.19.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Portfolio.Domain\Portfolio.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Mapper\" />
  </ItemGroup>

</Project>

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Environment": {
    "IsDevelopment": true
  },
  "Email": {
    "Processing": {
      "MaxOutboxRetries": 3
    }
  },
  "AWS": {
    "Secrets": {
      "SecretName": "portfolio-api-production"
    },
    "Lambda": {
      "EmailOutboxProcessingBuffer": "00:00:05",
      "DevelopmentFallbackTime": "00:01:00"
    }
  }
}

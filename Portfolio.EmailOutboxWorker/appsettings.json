{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Environment": {
    "IsDevelopment": true
  },
  "AWS": {
    "Secrets": {
      "SecretName": "portfolio-api-production"
    },
    "SQS": {
      "MaxEmailRetries": 3
    },
    "Lambda": {
      "EmailOutboxProcessorBuffer": "00:00:05",
      "DevelopmentFallbackTime": "00:01:00"
    }
  }
}
